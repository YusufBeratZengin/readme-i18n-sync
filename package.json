{
  "name": "readme-i18n-sync",
  "version": "0.1.0",
  "description": "Detect when translated documentation drifts from the source-language docs by comparing structure, not prose",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "i18n-sync": "./bin/i18n-sync.js",
    "readme-i18n-sync": "./bin/i18n-sync.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage",
    "test:watch": "node --test --watch",
    "check": "node ./bin/i18n-sync.js check",
    "demo": "node scripts/make-demo.mjs",
    "demo:check": "node scripts/make-demo.mjs --check",
    "lint": "node --check bin/i18n-sync.js src/*.js src/**/*.js test/*.test.js",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "i18n",
    "localization",
    "documentation",
    "readme",
    "markdown",
    "sync",
    "drift-detection",
    "github-actions",
    "cli"
  ],
  "author": "Yusuf Berat Zengin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufBeratZengin/readme-i18n-sync.git"
  },
  "bugs": {
    "url": "https://github.com/YusufBeratZengin/readme-i18n-sync/issues"
  },
  "homepage": "https://github.com/YusufBeratZengin/readme-i18n-sync#readme",
  "files": [
    "bin",
    "src",
    "docs/demo.svg",
    "schema.json",
    "README.md",
    "README.tr.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
